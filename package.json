{
  "name": "table-mountain-mcp",
  "version": "0.1.0",
  "description": "MCP server for tablemountainweather.com: should you go up Table Mountain today, and which day is best this week.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "eval:check": "tsx evals/run.ts --check",
    "eval": "tsx evals/run.ts"
  },
  "author": "Cobus Meyer",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "bin": {
    "table-mountain-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cobus-meyer/table-mountain-mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "weather",
    "cape-town",
    "table-mountain"
  ]
}
